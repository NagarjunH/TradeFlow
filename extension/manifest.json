{
  "manifest_version": 3,
  "name": "TradeFlow Vantage Bridge",
  "version": "1.1.0",
  "description": "Automatically sync closed trades & chart screenshots from Vantage Web-Trade Terminal (secure.vantagemarkets.com) directly into your TradeFlow Trading Journal.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://secure.vantagemarkets.com/*",
    "https://*.vantagemarkets.com/*",
    "https://stmmeddkycvhelvxgone.supabase.co/*",
    "http://localhost:*/*",
    "https://*.vercel.app/*",
    "https://*.netlify.app/*",
    "https://*.github.io/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TradeFlow Vantage Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://secure.vantagemarkets.com/web-trade*",
        "https://*.vantagemarkets.com/web-trade*",
        "https://secure.vantagemarkets.com/*"
      ],
      "js": [
        "vantage-content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:5173/*",
        "http://localhost:4173/*",
        "https://*.vercel.app/*",
        "https://*.netlify.app/*",
        "https://*.github.io/*"
      ],
      "js": [
        "tradeflow-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
